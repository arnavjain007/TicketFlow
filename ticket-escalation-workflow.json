            "name": "Daily Trigger",
            "type": "n8n-nodes-base.scheduleTrigger",
            "typeVersion": 1.2,
            "position": [
                -944,
                -320
            ]
        },
        {
            "parameters": {
                "method": "POST",
                "url": "http://172.17.0.1:8000/api/tickets/escalation-due",
                "sendBody": true,
                "specifyBody": "json",
                "jsonBody": "={{ { \"days_without_response\": 0 } }}",
                "options": {}
            },
            "id": "21d9728a-312c-47c8-8aed-294298bf6760",
            "name": "Get Open Tickets For Escalation",
            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 4.2,
            "position": [
                -720,
                -320
            ]
        },
        {
            "parameters": {
                "jsCode": "const data = $input.first().json;\n\n// Support either:\n// 1. backend returns an array directly\n// 2. backend returns { tickets: [...] }\n// 3. backend returns { data: [...] }\nlet tickets = [];\n\nif (Array.isArray(data)) {\n  tickets = data;\n} else if (Array.isArray(data.tickets)) {\n  tickets = data.tickets;\n} else if (Array.isArray(data.data)) {\n  tickets = data.data;\n}\n\nreturn tickets.map(ticket => ({ json: ticket }));"
            },
            "id": "09564abe-4927-469f-b154-7372f95d1762",
            "name": "Split Tickets",
            "type": "n8n-nodes-base.code",
            "typeVersion": 2,
            "position": [
                -496,
                -320
            ]
        },
        {
            "parameters": {
                "jsCode": "return $input.all().map(item => {\n  const raw = item.json;\n  const t = raw.data || raw;\n\n  const assignedLabel =\n    t.assigned_to === 'dev' ? 'Developer' :\n    t.assigned_to === 'manager' ? 'Manager' :\n    t.assigned_to === 'senior_manager' ? 'Senior Manager' :\n    t.assigned_to === 'support_team' ? 'Support Team' :\n    t.assigned_to || 'Unknown Assignee';\n\n  return {\n    json: {\n      ...t,\n      conversationId: t.conversationId || null,\n      teamsPayload: {\n        \"@type\": \"MessageCard\",\n        \"@context\": \"http://schema.org/extensions\",\n        \"summary\": `Ticket escalation: ${t.id || ''}`,\n        \"themeColor\": \"E81123\",\n        \"title\": \"Ticket Escalation\",\n        \"text\": `CHAT_CONVERSATION_ID: ${t.conversationId || 'N/A'}`,\n        \"sections\": [\n          {\n            \"facts\": [\n              { \"name\": \"Ticket ID\", \"value\": t.id || '' },\n              { \"name\": \"Title\", \"value\": t.title || 'Support Ticket' },\n              { \"name\": \"Description\", \"value\": t.description || 'No description available' },\n              { \"name\": \"Priority\", \"value\": t.priority || 'Medium' },\n              { \"name\": \"Category\", \"value\": t.category || 'manual_ticket' },\n              { \"name\": \"Assigned To\", \"value\": assignedLabel },\n              { \"name\": \"Status\", \"value\": t.status || 'escalated' },\n              { \"name\": \"Escalation Level\", \"value\": String(t.escalation_level || 0) },\n              { \"name\": \"Created At\", \"value\": t.created_at || '' },\n              { \"name\": \"Chat Summary\", \"value\": t.chat_summary || 'No summary available' }\n            ]\n          }\n        ]\n      }\n    }\n  };\n});"
            },
            "id": "6c50b4b2-1077-4cc1-ac70-e1b22d2feabb",
            "name": "Prepare Escalation Teams Message",
            "type": "n8n-nodes-base.code",
            "typeVersion": 2,
            "position": [
                -48,
                -320
            ]
        },
        {
            "parameters": {
                "method": "POST",
                "url": "=https://defaulted1e38cdc228417082d81b69381f2c.0c.environment.api.powerplatform.com:443/powerautomate/automations/direct/workflows/2550ce5f918e49fb9445d811f387ea9d/triggers/manual/paths/invoke?api-version=1&sp=%2Ftriggers%2Fmanual%2Frun&sv=1.0&sig=9q-QwqYZapL82iXTEjskwERNfpMuTH7PCzoSJVKe_Vo",
                "sendBody": true,
                "specifyBody": "json",
                "jsonBody": "={{ $json.teamsPayload }}",
                "options": {}
            },
            "id": "b4ec1404-e34f-44b9-b1e9-9b5892cdecb2",
            "name": "Send Escalation To Teams",
            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 4.2,
            "position": [
                176,
                -320
            ]
        },
        {
            "parameters": {
                "method": "POST",
                "url": "http://172.17.0.1:8000/api/tickets/mark-escalated",
                "sendBody": true,
                "specifyBody": "json",
                "jsonBody": "={{ {\n  \"ticket_id\": $json.id,\n  \"escalated\": true,\n  \"escalated_at\": new Date().toISOString()\n} }}",
                "options": {}
            },
            "id": "f1f02b1e-d6f3-40ac-b764-1bd9f517b467",
            "name": "Mark Ticket Escalated",
            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 4.2,
            "position": [
                -272,
