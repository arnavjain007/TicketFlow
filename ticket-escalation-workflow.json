            ]
        },
        {
            "parameters": {
                "method": "POST",
                "url": "=http://172.17.0.1:8000/api/teams/register-thread",
                "sendBody": true,
                "specifyBody": "json",
                "jsonBody": "={\n  \"teamsMessageId\": \"{{ $('Extract Teams message id').item.json.teamsMessageId }}\",\n  \"conversationId\": \"{{ $('Prepare Escalation Teams Message').item.json.conversationId }}\",\n  \"ticket_id\": \"{{ $('Prepare Escalation Teams Message').item.json.id }}\"\n}",
                "options": {}
            },
            "id": "c5d4a11a-8a26-4d8e-9c41-a290390dd124",
            "name": "Register Teams Thread Mapping",
            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 4.2,
            "position": [
                720,
                -432
            ]
        },
        {
            "parameters": {
                "jsCode": "return [\n  {\n    json: {\n      teamsMessageId:\n        $json.teamsMessageId ||\n        $json.messageId ||\n        $json.id ||\n        ''\n    }\n  }\n];"
            },
            "type": "n8n-nodes-base.code",
