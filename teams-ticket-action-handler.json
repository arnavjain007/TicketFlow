{
    "name": "Teams Ticket Action Handler",
    "nodes": [
        {
            "parameters": {
                "httpMethod": "POST",
                "path": "teams-ticket-action",
                "responseMode": "responseNode",
                "options": {}
            },
            "id": "1",
            "name": "Webhook",
            "type": "n8n-nodes-base.webhook",
            "typeVersion": 2,
            "position": [
                200,
                300
            ],
            "webhookId": "teams-ticket-action-webhook"
        },
        {
            "parameters": {
                "jsCode": "const input = $input.first().json;\nconst body = input.body || input;\n\nconst ticket_id = body.ticket_id || body.ticketId || '';\nconst action = String(body.action || '').toLowerCase().trim();\nconst responder = body.responder || body.user || body.displayName || 'Unknown';\nconst note = body.note || body.comment || '';\n\nreturn [{\n  json: {\n    ticket_id,\n    action,\n    responder,\n    note\n  }\n}];"
            },
            "id": "2",
            "name": "Parse Teams Action",
            "type": "n8n-nodes-base.code",
            "typeVersion": 2,
            "position": [
                440,
                300
            ]
        },
        {
            "parameters": {
                "conditions": {
                    "options": {
                        "caseSensitive": false,
                        "leftValue": "",
                        "typeValidation": "strict",
                        "version": 2
                    },
                    "conditions": [
                        {
                            "id": "a1",
                            "leftValue": "={{ $json.action }}",
                            "rightValue": "acknowledge",
                            "operator": {
                                "type": "string",
                                "operation": "equals"
                            }
                        },
                        {
                            "id": "a2",
                            "leftValue": "={{ $json.action }}",
                            "rightValue": "in_progress",
                            "operator": {
                                "type": "string",
                                "operation": "equals"
                            }
                        }
                    ],
                    "combinator": "or"
                },
                "options": {}
            },
            "id": "3",
            "name": "Is Acknowledge Or In Progress?",
            "type": "n8n-nodes-base.if",
            "typeVersion": 2,
            "position": [
                700,
                300
            ]
        },
        {
            "parameters": {
                "conditions": {
                    "options": {
                        "caseSensitive": false,
                        "leftValue": "",
                        "typeValidation": "strict",
                        "version": 2
                    },
                    "conditions": [
                        {
                            "id": "b1",
                            "leftValue": "={{ $json.action }}",
                            "rightValue": "resolved",
                            "operator": {
                                "type": "string",
                                "operation": "equals"
                            }
                        }
                    ],
                    "combinator": "and"
                },
                "options": {}
            },
            "id": "4",
            "name": "Is Resolved?",
            "type": "n8n-nodes-base.if",
            "typeVersion": 2,
            "position": [
                980,
                420
            ]
        },
        {
            "parameters": {
                "method": "POST",
                "url": "http://172.17.0.1:8000/api/tickets/respond",
                "sendBody": true,
                "specifyBody": "json",
                "jsonBody": "={{ {\n  \"ticket_id\": $json.ticket_id,\n  \"responder\": $json.responder,\n  \"note\": $json.note || \"Updated from Teams\",\n  \"status\": \"in_progress\"\n} }}",
                "options": {}
            },
            "id": "5",
            "name": "Mark In Progress",
            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 4.2,
            "position": [
                980,
                180
            ]
        },
        {
            "parameters": {
                "method": "POST",
                "url": "http://172.17.0.1:8000/api/tickets/resolve",
                "sendBody": true,
                "specifyBody": "json",
                "jsonBody": "={{ {\n  \"ticket_id\": $json.ticket_id,\n  \"resolver\": $json.responder,\n  \"note\": $json.note || \"Resolved from Teams\"\n} }}",
                "options": {}
            },
            "id": "6",
            "name": "Resolve Ticket",
            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 4.2,
            "position": [
                1240,
                420
            ]
        },
        {
            "parameters": {
                "jsCode": "return [{\n  json: {\n    success: false,\n    message: `Unsupported action: ${$json.action || 'empty'}`\n  }\n}];"
            },
            "id": "7",
            "name": "Unsupported Action",
            "type": "n8n-nodes-base.code",
            "typeVersion": 2,
            "position": [
                1240,
                620
            ]
        },
        {
            "parameters": {
                "respondWith": "json",
                "responseBody": "={{ $json }}",
                "options": {}
            },
            "id": "8",
            "name": "Respond to Webhook",
            "type": "n8n-nodes-base.respondToWebhook",
            "typeVersion": 1.1,
